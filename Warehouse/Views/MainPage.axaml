<!-- Views/MainPage.axaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WarehouseApp.Views.MainPage">
    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="Каталог товаров" FontSize="20" Margin="0,0,0,15"/>
            <ItemsControl Name="ProductsPanel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#f8f8f8" CornerRadius="8" Padding="12" Margin="8"
                                Width="220" Height="180" BorderBrush="#ddd" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding CategoryName}" Foreground="#555" FontSize="12" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding QuantityInStock, StringFormat='Остаток: {0}'}" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding Unit}" Foreground="#777" FontSize="11"/>
                                <TextBlock Text="{Binding SellingPrice, StringFormat='Цена: {0:C}'}" 
                                           FontWeight="Bold" FontSize="14" Foreground="#2a8a2a" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
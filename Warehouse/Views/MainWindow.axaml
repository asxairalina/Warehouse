<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Warehouse.MainWindow"
        WindowStartupLocation="CenterScreen"
        Title="Система управления строительным складом" Width="350" Height="350">
    <StackPanel Margin="30">
        <TextBlock Text="Строительный склад" Classes="h1" HorizontalAlignment="Center" Margin="0,0,0,20" />

        <TextBlock Text="Логин:" Classes="secondary" Margin="0,0,0,5" />
        <TextBox Name="TxtUsername" Margin="0,0,0,15" />

        <TextBlock Text="Пароль:" Classes="secondary" Margin="0,0,0,5" />
        <TextBox Name="TxtPassword" PasswordChar="*" Margin="0,0,0,15" />
        
        <WrapPanel VerticalAlignment="Center">
            <Button Content="Войти" Click="BtnLogin_Click" Margin="0,0,20,0" />
        </WrapPanel>
    </StackPanel>
</Window>
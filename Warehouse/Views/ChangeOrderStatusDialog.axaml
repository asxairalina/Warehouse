<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Warehouse.ChangeOrderStatusDialog"
        Title="Izmenenie statusa zakaza"
        Width="300" Height="200"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Izmenenie statusa zakaza:" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Name="TxtOrderInfo" Margin="0,10,0,20"/>
        
        <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="10">
            <TextBlock Text="Noviy status:"/>
            <ComboBox Name="CmbStatus" Width="150">
                <ComboBoxItem Content="Noviy" Tag="new"/>
                <ComboBoxItem Content="Podtverjden" Tag="confirmed"/>
                <ComboBoxItem Content="Zarezervirovan" Tag="reserved"/>
            </ComboBox>
        </StackPanel>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="Sokhranit" Click="BtnSave_Click" Width="80"/>
            <Button Content="Otmena" Click="BtnCancel_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>